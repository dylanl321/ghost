{
  "name": "ghost-dashboard",
  "version": "1.17.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "npm run bundle:support && nuxt build",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=12288' nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt start",
    "bundle:support": "tsx scripts/bundle-support-articles.ts",
    "seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "validate": "tsx scripts/validate-codebase.ts",
    "validate:fix": "tsx scripts/validate-codebase.ts --fix",
    "check:types": "npx nuxi typecheck",
    "check:lint": "npx eslint . --ext .ts,.vue,.js",
    "check:lint:fix": "npx eslint . --ext .ts,.vue,.js --fix",
    "check:unused": "npx ts-prune --project tsconfig.json",
    "check:deps": "npx depcheck --ignores=\"@nuxt/*,nuxt-*,@types/*,eslint,typescript\"",
    "check:files": "npx unimported",
    "changelog:generate": "tsx scripts/generate-changelog.ts"
  },
