{
  "name": "ghost-dashboard",
  "version": "1.19.0",
  "type": "module",
  "private": true,
  "packageManager": "npm@11.18.0",
  "engines": {
    "node": ">=22.22.2 <25",
    "npm": ">=11.0.0 <12"
  },
  "scripts": {
    "build": "npm run bundle:support && nuxt build",
    "dev": "cross-env NODE_OPTIONS='--max-old-space-size=12288' nuxt dev",
    "generate": "nuxt generate",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "start": "nuxt start",
    "bundle:support": "tsx scripts/bundle-support-articles.ts",
    "seed:email-templates": "tsx scripts/seed-email-templates.ts",
    "mcp:secrets": "tsx scripts/generate-mcp-oauth-secrets.ts",
    "ghost:aws": "tsx scripts/ghost-aws.ts",
    "validate": "tsx scripts/validate-codebase.ts",
    "validate:fix": "tsx scripts/validate-codebase.ts --fix",
    "check:types": "nuxi typecheck",
    "check:lint": "eslint . --ext .ts,.vue,.js",
    "check:lint:fix": "eslint . --ext .ts,.vue,.js --fix",
    "check:unused": "ts-prune --project tsconfig.json",
    "check:deps": "depcheck --ignores=\"@nuxt/*,nuxt-*,@types/*,eslint,typescript\"",
    "test:chat": "tsx --test tests/chat/*.test.ts",
    "test:mcp": "tsx --test tests/mcp/*.test.ts",
    "test:vmaas": "tsx --test tests/vmaas/*.test.ts",
    "test:budget-recipients": "tsx --test server/utils/__tests__/manual-budget-alert-recipients.test.ts",
    "changelog:generate": "tsx scripts/generate-changelog.ts"
  },
