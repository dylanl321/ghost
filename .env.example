# AWS Commercial Environment
AWS_COMMERCIAL_ACCESS_KEY_ID=your-commercial-access-key
AWS_COMMERCIAL_SECRET_ACCESS_KEY=your-commercial-secret-key
AWS_COMMERCIAL_REGION=us-east-1
AWS_COMMERCIAL_ORGANIZATIONS_ACCOUNT_ID=your-master-account-id
# Optional: Session token for temporary credentials
# AWS_COMMERCIAL_SESSION_TOKEN=your-session-token

# AWS GovCloud Environment
AWS_GOVCLOUD_ACCESS_KEY_ID=your-govcloud-access-key
AWS_GOVCLOUD_SECRET_ACCESS_KEY=your-govcloud-secret-key
AWS_GOVCLOUD_REGION=us-gov-west-1
AWS_GOVCLOUD_ORGANIZATIONS_ACCOUNT_ID=your-govcloud-master-account-id
AWS_GOVCLOUD_ORGANIZATIONS_ROLE_PATH=GD
# Optional: Session token for temporary credentials
# AWS_GOVCLOUD_SESSION_TOKEN=your-session-token

# Cross-Account Role Configuration
AWS_ASSUME_ROLE_NAME=GDMSOrganizationsRole
AWS_ASSUME_ROLE_DURATION=3600
# Optional: External ID for role assumption
# AWS_ASSUME_ROLE_EXTERNAL_ID=your-external-id

# Account Management
# AWS_ACCOUNTS_TABLE_NAME=gdms-accounts
# Optional: Default table name if AWS_ACCOUNTS_TABLE_NAME is not set
# AWS_ACCOUNTS_DEFAULT_TABLE=gdms_aws_accounts-master

# Billing and Cost Management
# Master account for raw AWS billing data
AWS_MASTER_ACCOUNT_ID=205950196477
# GovCloud payer/management account for billable Cost Explorer requests
AWS_GOVCLOUD_MASTER_ACCOUNT_ID=your-govcloud-master-account-id
# Billing Conductor account for proforma costs with savings plans
AWS_PROFORMA_ACCOUNT_ID=253821132832

# VMaaS is fixed to GovCloud 650505514334 and commercial billing pair 871049984747.
# Organization CloudTrail MCP queries read the master-account CloudWatch log groups.
GHOST_CLOUDTRAIL_GOVCLOUD_ACCOUNT_ID=374673712317
GHOST_CLOUDTRAIL_GOVCLOUD_ORGANIZATION_ID=o-oiu9mwd7zf
GHOST_CLOUDTRAIL_GOVCLOUD_REGION=us-gov-west-1
GHOST_CLOUDTRAIL_GOVCLOUD_LOG_GROUP=aws-cloudtrail-logs-374673712317-d7a04176
GHOST_CLOUDTRAIL_COMMERCIAL_ACCOUNT_ID=205950196477
GHOST_CLOUDTRAIL_COMMERCIAL_ORGANIZATION_ID=o-sb7o7424ts
GHOST_CLOUDTRAIL_COMMERCIAL_REGION=us-east-1
GHOST_CLOUDTRAIL_COMMERCIAL_LOG_GROUP=CloudTrail/DefaultLogGroup
# Additional central accounts that must never receive direct-query credential guidance.
GHOST_MCP_CENTRAL_ACCOUNT_IDS=
# These management accounts supply billable and Billing Conductor actuals.
# VMAAS callers cannot override either account.

# AWS Config Service
# Config aggregator names for resource discovery (environment-specific)
AWS_COMMERCIAL_CONFIG_AGGREGATOR=GDMS_Aggregator
AWS_GOVCLOUD_CONFIG_AGGREGATOR=GDMSAggregator

# AWS Security Lake Configuration
# Security Lake regions where data is aggregated
AWS_COMMERCIAL_SECURITY_LAKE_REGION=us-east-1
AWS_GOVCLOUD_SECURITY_LAKE_REGION=us-gov-west-1

# Security Lake monitoring accounts where data is centralized
AWS_COMMERCIAL_SECURITY_LAKE_ACCOUNT=253821132832
AWS_GOVCLOUD_SECURITY_LAKE_ACCOUNT=083876038518

# Security Lake S3 bucket names (auto-discovered if not specified)
# AWS_COMMERCIAL_SECURITY_LAKE_BUCKET=aws-security-data-lake-us-east-1-253821132832
# AWS_GOVCLOUD_SECURITY_LAKE_BUCKET=aws-security-data-lake-us-gov-west-1-083876038518

# Athena query results S3 buckets (required for Security Lake queries)
AWS_COMMERCIAL_ATHENA_RESULTS_BUCKET=aws-athena-query-results-us-east-1-253821132832
AWS_GOVCLOUD_ATHENA_RESULTS_BUCKET=aws-athena-query-results-us-gov-west-1-083876038518

# AWS Bedrock Configuration (optional)
# Region for Bedrock operations (defaults to GovCloud region)
# BEDROCK_REGION=us-gov-west-1

# Amazon Nova Model Configuration
# BEDROCK_NOVA_MODEL_ID=amazon.nova-pro-v1:0
# BEDROCK_NOVA_MAX_TOKENS=4096
# BEDROCK_NOVA_TEMPERATURE=0.7
# BEDROCK_NOVA_TOP_P=0.9
# Comma-separated list of fallback models for Nova
# BEDROCK_NOVA_FALLBACK_MODELS=amazon.nova-micro-v1:0

# Claude Model Configuration
# BEDROCK_CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_CLAUDE_MAX_TOKENS=4096
# BEDROCK_CLAUDE_TEMPERATURE=0.3
# BEDROCK_CLAUDE_TOP_P=0.95
# Comma-separated list of fallback models for Claude
# BEDROCK_CLAUDE_FALLBACK_MODELS=anthropic.claude-3-5-sonnet-20240620-v1:0,anthropic.claude-3-sonnet-20240229-v1:0,anthropic.claude-v2:1

# =====================================================
# ENTRA ID (AZURE AD) GOVERNMENT CLOUD CONFIGURATION
# =====================================================

# Core Entra ID Configuration (Required for Azure Government)
ENTRA_TENANT_ID=your-azure-gov-tenant-guid-here
ENTRA_CLIENT_ID=your-azure-gov-app-registration-guid-here
ENTRA_CLIENT_SECRET=your-azure-gov-client-secret-here

# Azure Government Cloud Endpoints (Configurable)
ENTRA_LOGIN_BASE_URL=https://login.microsoftonline.us
ENTRA_GRAPH_BASE_URL=https://graph.microsoft.us
ENTRA_GRAPH_VERSION=v1.0

# Note: For Azure Commercial Cloud, use:
# ENTRA_LOGIN_BASE_URL=https://login.microsoftonline.com
# ENTRA_GRAPH_BASE_URL=https://graph.microsoft.com

# Optional: If you have separate tenants for different AWS environments
# ENTRA_COMMERCIAL_TENANT_ID=commercial-azure-gov-tenant-guid
# ENTRA_GOVCLOUD_TENANT_ID=govcloud-azure-gov-tenant-guid

# Entra ID Search Optimization
# ENTRA_AWS_GROUPS_OU=OU=AWSGroups,OU=Security,DC=domain,DC=com
ENTRA_AWS_GROUP_PREFIX=AWS_
ENTRA_DISTRIBUTION_GROUP_SUFFIX=.aws
ENTRA_OWNER_DELIMITER=" // "

# Entra ID Performance Settings
ENTRA_CACHE_TTL=3600        # Cache TTL in seconds (1 hour)
ENTRA_BATCH_SIZE=999        # Graph API batch size (max 999)
ENTRA_MAX_RETRIES=3         # Max retry attempts for Graph API

# Development and Testing (Azure Government)
NODE_ENV=development

# Dev Mode Authentication (nuxt-oidc-auth devMode)
# When enabled, creates a mock session without requiring Entra login
DEV_AUTH_ENABLED=false                          # Set to 'true' to enable dev mode auth
DEV_USER_EMAIL=dev@localhost                    # Email for dev mode user
DEV_USER_NAME=Dev User                          # Display name for dev mode user
DEV_USER_GROUPS=AWS-Product-Team                # Comma-separated groups (controls admin access)

# Legacy auth bypass settings (DEPRECATED - DO NOT USE)
# AUTH_BYPASS and ENTRA_DEV_BYPASS have been removed for security reasons.
# Use DEV_AUTH_ENABLED=true above for development authentication.
# AUTH_BYPASS=false                              # REMOVED - use DEV_AUTH_ENABLED instead
# ENTRA_DEV_BYPASS=false                         # REMOVED - use DEV_AUTH_ENABLED instead
ENTRA_TEST_ACCESS_TOKEN=your-azure-gov-test-token  # For Azure Gov Graph API testing
ENTRA_TEST_USER_EMAIL=test@gd-ms.com            # Test user email
ENTRA_DEFAULT_DOMAIN=gd-ms.com                  # Default domain for user lookups

# =====================================================
# API KEY MANAGEMENT
# =====================================================

# DynamoDB Configuration for API Keys
DYNAMODB_API_KEYS_TABLE=ghost-api-keys

# =====================================================
# HOSTED MCP AND OAUTH
# =====================================================
# Public origin used to construct the MCP resource and OAuth issuer URLs.
GHOST_MCP_BASE_URL=http://localhost:3000
GHOST_OAUTH_ISSUER=http://localhost:3000
GHOST_OAUTH_TABLE_NAME=ghost-oauth-artifacts-dev
GHOST_OAUTH_AUTHORIZATION_TTL_DAYS=90
GHOST_MCP_AUDIT_TABLE_NAME=ghost-mcp-audit-dev
GHOST_MCP_RAW_ERRORS_TABLE_NAME=ghost-mcp-raw-errors-dev

# Generate these with: npm run mcp:secrets
# Store production values in Secrets Manager; never commit generated values.
GHOST_OAUTH_JWKS_JSON=
GHOST_OAUTH_COOKIE_KEYS=
GHOST_MCP_REQUEST_STATE_KEY=

# Optional comma-separated browser origins and hostnames.
GHOST_MCP_ALLOWED_ORIGINS=http://localhost:3000
GHOST_MCP_ALLOWED_HOSTS=localhost
GHOST_MCP_RATE_LIMIT_PER_MINUTE=120
GHOST_MCP_AI_RATE_LIMIT_PER_MINUTE=10
GHOST_MCP_EXPORT_RATE_LIMIT_PER_HOUR=5
GHOST_OAUTH_REGISTRATION_RATE_LIMIT_PER_HOUR=10

# =====================================================
# USER NOTIFICATION SYSTEM
# =====================================================
USER_NOTIFICATIONS_TABLE=ghost-user-notifications
NOTIFICATION_BROADCASTS_TABLE=ghost-notification-broadcasts
SITE_CONFIG_TABLE=ghost-site-config
API_KEYS_STORAGE_ENV=commercial          # 'commercial' or 'govcloud'

# Durable dataset exports (24-hour retention)
DATASET_EXPORT_JOBS_TABLE_NAME=ghost-dataset-export-jobs
DATASET_EXPORT_JOBS_QUEUE_URL=https://sqs.us-gov-west-1.amazonaws.com/ACCOUNT_ID/ghost-dataset-export-jobs
DATASET_EXPORT_WORKER_ENABLED=true

# =====================================================
# ORGANIZATION AI USAGE
# =====================================================
AI_USAGE_TABLE_NAME=ghost-ai-usage
AI_USAGE_COLLECTION_ENABLED=false
# Optional comma-separated overrides; defaults cover the US regions below.
AI_USAGE_COMMERCIAL_REGIONS=us-east-1,us-east-2,us-west-1,us-west-2
AI_USAGE_GOVCLOUD_REGIONS=us-gov-west-1,us-gov-east-1
